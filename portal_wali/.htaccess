# .htaccess untuk Portal Wali Santri
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Jangan rewrite jika file atau direktori fisik ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URL: dukung akses tanpa .php
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

