# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    # Aktifkan Rewrite Engine
    RewriteEngine On

    # 1. Kecualikan folder 'api' HANYA jika mengakses file langsung
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^.*/api/ [NC]
    RewriteRule ^api/ - [L]

    # Prevent direct access to directories (Termasuk folder api/ jika tanpa nama file)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*)$ index.php [L]

    # 2. Hapus ekstensi .php dari URL (Redirect eksternal)
    # Kecualikan juga folder 'logic' dan 'api' dari pengalihan ini agar AJAX POST tidak error
    # Tambahkan pengecekan agar POST request tidak di-redirect (mencegah kehilangan data POST)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !/(api|logic)/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,QSA]

    # 3. Tambahkan ekstensi .php secara internal
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [NC,L]
</IfModule>
