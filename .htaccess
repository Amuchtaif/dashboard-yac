<IfModule mod_rewrite.c>
    # Aktifkan Rewrite Engine
    RewriteEngine On

    # 1. Kecualikan folder 'api' dari semua aturan di bawah
    # Jika request dimulai dengan 'api/', lewati semua aturan htaccess ini
    RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^.*/api/ [NC]
    RewriteRule ^api/ - [L]

    # 2. Hapus ekstensi .php dari URL (Redirect eksternal)
    # Kecualikan juga folder 'logic' dari pengalihan ini agar AJAX POST tidak error
    RewriteCond %{REQUEST_URI} !^/logic/ [NC]
    RewriteCond %{REQUEST_URI} !^.*/logic/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. Tambahkan ekstensi .php secara internal
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [NC,L]
</IfModule>
