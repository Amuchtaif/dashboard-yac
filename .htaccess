# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    # Aktifkan Rewrite Engine
    RewriteEngine On
    RewriteBase /

    # Public Agenda Route (Dukungan dengan atau tanpa trailing slash)
    RewriteRule ^agenda-pendidikan/?$ views/agenda/public.php [QSA,NC,L]
    RewriteRule ^views/agenda/public/?$ views/agenda/public.php [QSA,NC,L]

    # Custom API routes with ID parameters
    RewriteRule ^api/tahfidz/entries/([0-9]+)$ api/tahfidz/entries.php?id=$1 [QSA,NC,L]
    RewriteRule ^api/tahfidz/baselines/([0-9]+)$ api/tahfidz/baselines.php?id=$1 [QSA,NC,L]

    # Amaliyah Admin routes
    RewriteRule ^api/activity-types/([0-9]+)/status$ api/activity_types.php?id=$1&action=status [QSA,NC,L]
    RewriteRule ^api/activity-types/([0-9]+)$ api/activity_types.php?id=$1 [QSA,NC,L]
    RewriteRule ^api/activity-types$ api/activity_types.php [QSA,NC,L]
    RewriteRule ^api/student-activities/([0-9]+)/attachments/([0-9]+)$ api/attachments.php?activity_id=$1&attachment_id=$2 [QSA,NC,L]
    RewriteRule ^api/student-activities/([0-9]+)/attachments$ api/attachments.php?activity_id=$1 [QSA,NC,L]
    RewriteRule ^api/student-activities/([0-9]+)$ api/student_activities.php?id=$1 [QSA,NC,L]
    RewriteRule ^api/student-activities$ api/student_activities.php [QSA,NC,L]

    # Amaliyah Mobile routes
    RewriteRule ^api/mobile/activity-types$ api/mobile/activity_types.php [QSA,NC,L]
    RewriteRule ^api/mobile/students$ api/mobile/students.php [QSA,NC,L]
    RewriteRule ^api/mobile/student-activities/batch$ api/mobile/student_activities.php?action=batch [QSA,NC,L]
    RewriteRule ^api/mobile/student-activities/([0-9]+)/attachments/([0-9]+)$ api/mobile/attachments.php?activity_id=$1&attachment_id=$2 [QSA,NC,L]
    RewriteRule ^api/mobile/student-activities/([0-9]+)/attachments$ api/mobile/attachments.php?activity_id=$1 [QSA,NC,L]
    RewriteRule ^api/mobile/student-activities/([0-9]+)$ api/mobile/student_activities.php?id=$1 [QSA,NC,L]
    RewriteRule ^api/mobile/student-activities$ api/mobile/student_activities.php [QSA,NC,L]

    # 1. Kecualikan folder 'api' HANYA jika mengakses file langsung
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^.*/api/ [NC]
    RewriteRule ^api/ - [L]

    # Prevent direct access to directories (Termasuk folder api/ jika tanpa nama file)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*)$ index.php [L]

    # 2. Hapus ekstensi .php dari URL (Redirect eksternal)
    # Kecualikan folder 'logic', 'api', dan 'views/agenda' dari pengalihan ini agar route public & AJAX tidak error
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !/(api|logic|views/agenda)/ [NC]
    RewriteCond %{REQUEST_URI} !^/agenda-pendidikan [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,QSA]

    # 3. Tambahkan ekstensi .php secara internal
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [NC,L]
</IfModule>
